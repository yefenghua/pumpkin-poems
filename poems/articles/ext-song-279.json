      }
    },
    {
      "id": "ext-song-279-l004",
      "text": {
        "zh-Hant": "著我扁舟一葉。",
        "zh-Hans": "著我扁舟一叶。"
      }
    },
    {
      "id": "ext-song-279-l005",
      "text": {
        "zh-Hant": "素月分輝，",
        "zh-Hans": "素月分辉，"
      }
    },
    {
      "id": "ext-song-279-l006",
