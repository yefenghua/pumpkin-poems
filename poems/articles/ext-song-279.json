    },
    {
      "id": "ext-song-279-l007",
      "text": {
        "zh-Hant": "表裏俱澄澈。",
        "zh-Hans": "表里俱澄澈。"
      }
    },
    {
      "id": "ext-song-279-l008",
      "text": {
        "zh-Hant": "悠然心會，",
        "zh-Hans": "悠然心会，"
      }
    },
    {
      "id": "ext-song-279-l009",
      "text": {
        "zh-Hant": "妙處難與君説。",
        "zh-Hans": "妙处难与君说。"
      }
    },
    {
      "id": "ext-song-279-l010",
      "text": {
        "zh-Hant": "應念嶺海經年，",
        "zh-Hans": "应念岭海经年，"
      }
    },
    {
      "id": "ext-song-279-l011",
      "text": {
        "zh-Hant": "孤光自照，",
        "zh-Hans": "孤光自照，"
      }
    },
    {
      "id": "ext-song-279-l012",
      "text": {
        "zh-Hant": "肝肺皆冰雪。",
        "zh-Hans": "肝肺皆冰雪。"
      }
    },
    {
      "id": "ext-song-279-l013",
      "text": {
        "zh-Hant": "短髮蕭騷襟袖冷，",
        "zh-Hans": "短发萧骚襟袖冷，"
      }
    },
    {
      "id": "ext-song-279-l014",
      "text": {
        "zh-Hant": "穩泛滄浪空闊。",
        "zh-Hans": "稳泛沧浪空阔。"
      }
    },
    {
      "id": "ext-song-279-l015",
      "text": {
        "zh-Hant": "盡吸西江，",
        "zh-Hans": "尽吸西江，"
      }
    },
    {
      "id": "ext-song-279-l016",
      "text": {
        "zh-Hant": "細斟北斗，",
        "zh-Hans": "细斟北斗，"
      }
    },
    {
      "id": "ext-song-279-l017",
      "text": {
        "zh-Hant": "萬象為賓客。",
        "zh-Hans": "万象为宾客。"
      }
    },
    {
      "id": "ext-song-279-l018",
      "text": {
        "zh-Hant": "扣舷獨笑，",
        "zh-Hans": "扣舷独笑，"
      }
    },
    {
      "id": "ext-song-279-l019",
      "text": {
        "zh-Hant": "不知今夕何夕。",
        "zh-Hans": "不知今夕何夕。"
      }
    }
