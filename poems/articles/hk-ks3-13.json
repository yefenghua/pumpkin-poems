      "text": {
        "zh-Hant": "春花秋月何時了？",
        "zh-Hans": "春花秋月何时了？"
      }
    },
    {
      "id": "hk-ks3-13-l002",
      "text": {
        "zh-Hant": "往事知多少！",
        "zh-Hans": "往事知多少！"
      }
    },
    {
      "id": "hk-ks3-13-l003",
      "text": {
        "zh-Hant": "小樓昨夜又東風，",
        "zh-Hans": "小楼昨夜又东风，"
      }
    },
    {
      "id": "hk-ks3-13-l004",
      "text": {
        "zh-Hant": "故國不堪回首月明中！",
        "zh-Hans": "故国不堪回首月明中！"
      }
    },
    {
      "id": "hk-ks3-13-l005",
      "text": {
        "zh-Hant": "雕闌玉砌應猶在，",
        "zh-Hans": "雕阑玉砌应犹在，"
      }
    },
    {
      "id": "hk-ks3-13-l006",
      "text": {
        "zh-Hant": "只是朱顏改。",
        "zh-Hans": "只是朱颜改。"
      }
    },
    {
      "id": "hk-ks3-13-l007",
      "text": {
        "zh-Hant": "問君能有幾多愁？",
        "zh-Hans": "问君能有几多愁？"
      }
    },
    {
      "id": "hk-ks3-13-l008",
      "text": {
        "zh-Hant": "恰似一江春水向東流！",
        "zh-Hans": "恰似一江春水向东流！"
      }
    }
