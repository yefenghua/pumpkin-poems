      }
    },
    {
      "id": "ext-tang-207-l002",
      "text": {
        "zh-Hant": "城春草木深。",
        "zh-Hans": "城春草木深。"
      }
    },
    {
      "id": "ext-tang-207-l003",
      "text": {
        "zh-Hant": "感時花濺淚，",
        "zh-Hans": "感时花溅泪，"
      }
    },
    {
      "id": "ext-tang-207-l004",
      "text": {
        "zh-Hant": "恨別鳥驚心。",
        "zh-Hans": "恨别鸟惊心。"
      }
    },
    {
      "id": "ext-tang-207-l005",
      "text": {
        "zh-Hant": "烽火連三月，",
        "zh-Hans": "烽火连三月，"
      }
    },
    {
      "id": "ext-tang-207-l006",
      "text": {
        "zh-Hant": "家書抵萬金。",
        "zh-Hans": "家书抵万金。"
      }
    },
    {
      "id": "ext-tang-207-l007",
      "text": {
        "zh-Hant": "白頭搔更短，",
        "zh-Hans": "白头搔更短，"
      }
    },
    {
      "id": "ext-tang-207-l008",
      "text": {
        "zh-Hant": "渾欲不勝簪。",
        "zh-Hans": "浑欲不胜簪。"
      }
    }
