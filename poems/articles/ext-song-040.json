  "lines": [
    {
      "id": "ext-song-040-l001",
      "text": {
        "zh-Hant": "莫聽穿林打葉聲。",
        "zh-Hans": "莫听穿林打叶声。"
      }
    },
    {
      "id": "ext-song-040-l002",
      "text": {
        "zh-Hant": "何妨吟嘯且徐行。",
        "zh-Hans": "何妨吟啸且徐行。"
      }
    },
    {
      "id": "ext-song-040-l003",
      "text": {
        "zh-Hant": "竹杖芒鞋輕勝馬。",
        "zh-Hans": "竹杖芒鞋轻胜马。"
      }
    },
    {
      "id": "ext-song-040-l004",
      "text": {
        "zh-Hant": "誰怕。",
        "zh-Hans": "谁怕。"
      }
    },
    {
      "id": "ext-song-040-l005",
      "text": {
        "zh-Hant": "一蓑煙雨任平生。",
        "zh-Hans": "一蓑烟雨任平生。"
      }
    },
    {
      "id": "ext-song-040-l006",
      "text": {
        "zh-Hant": "料峭春風吹酒醒。",
        "zh-Hans": "料峭春风吹酒醒。"
      }
    },
    {
      "id": "ext-song-040-l007",
      "text": {
        "zh-Hant": "微冷。",
        "zh-Hans": "微冷。"
      }
    },
    {
      "id": "ext-song-040-l008",
      "text": {
        "zh-Hant": "山頭斜照卻相迎。",
        "zh-Hans": "山头斜照却相迎。"
      }
    },
    {
      "id": "ext-song-040-l009",
      "text": {
        "zh-Hant": "回首向來蕭瑟處。",
        "zh-Hans": "回首向来萧瑟处。"
      }
    },
    {
      "id": "ext-song-040-l010",
      "text": {
        "zh-Hant": "歸去。",
        "zh-Hans": "归去。"
      }
    },
    {
      "id": "ext-song-040-l011",
      "text": {
        "zh-Hant": "也無風雨也無晴。",
        "zh-Hans": "也无风雨也无晴。"
      }
    }
  ],
