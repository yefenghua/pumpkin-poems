      "text": {
        "zh-Hant": "勸君莫惜金縷衣，",
        "zh-Hans": "劝君莫惜金缕衣，"
      }
    },
    {
      "id": "hk-ks1-14-l002",
      "text": {
        "zh-Hant": "勸君惜取少年時！",
        "zh-Hans": "劝君惜取少年时！"
      }
    },
    {
      "id": "hk-ks1-14-l003",
      "text": {
        "zh-Hant": "花開堪折直須折，",
        "zh-Hans": "花开堪折直须折，"
      }
    },
    {
      "id": "hk-ks1-14-l004",
      "text": {
        "zh-Hant": "莫待無花空折枝。",
        "zh-Hans": "莫待无花空折枝。"
      }
    }
  ],
