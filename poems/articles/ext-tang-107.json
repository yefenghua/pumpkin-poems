      }
    },
    {
      "id": "ext-tang-107-l002",
      "text": {
        "zh-Hant": "池月漸東上。",
        "zh-Hans": "池月渐东上。"
      }
    },
    {
      "id": "ext-tang-107-l003",
      "text": {
        "zh-Hant": "散髮乘夕涼，",
        "zh-Hans": "散发乘夕凉，"
      }
    },
    {
