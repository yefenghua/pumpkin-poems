  "lines": [
    {
      "id": "hk-ks4-17b-l001",
      "text": {
        "zh-Hant": "尋尋覓覓，",
        "zh-Hans": "寻寻觅觅，"
      }
    },
    {
      "id": "hk-ks4-17b-l002",
      "text": {
        "zh-Hant": "冷冷清清，",
        "zh-Hans": "冷冷清清，"
      }
    },
    {
      "id": "hk-ks4-17b-l003",
      "text": {
        "zh-Hant": "悽悽慘慘戚戚。",
        "zh-Hans": "凄凄惨惨戚戚。"
      }
    },
    {
      "id": "hk-ks4-17b-l004",
      "text": {
        "zh-Hant": "乍煖還寒時候，",
        "zh-Hans": "乍煖还寒时候，"
      }
    },
    {
      "id": "hk-ks4-17b-l005",
      "text": {
        "zh-Hant": "最難將息。",
        "zh-Hans": "最难将息。"
      }
    },
    {
      "id": "hk-ks4-17b-l006",
      "text": {
        "zh-Hant": "三杯兩盞淡酒，",
        "zh-Hans": "三杯两盏淡酒，"
      }
    },
    {
      "id": "hk-ks4-17b-l007",
      "text": {
        "zh-Hant": "怎敵他，",
        "zh-Hans": "怎敌他，"
      }
    },
    {
      "id": "hk-ks4-17b-l008",
      "text": {
        "zh-Hant": "晚來風急！",
        "zh-Hans": "晚来风急！"
      }
    },
    {
      "id": "hk-ks4-17b-l009",
      "text": {
        "zh-Hant": "雁過也，",
        "zh-Hans": "雁过也，"
      }
    },
    {
      "id": "hk-ks4-17b-l010",
      "text": {
        "zh-Hant": "正傷心，",
        "zh-Hans": "正伤心，"
      }
    },
    {
      "id": "hk-ks4-17b-l011",
      "text": {
        "zh-Hant": "卻是舊時相識。",
        "zh-Hans": "却是旧时相识。"
      }
    },
    {
      "id": "hk-ks4-17b-l012",
      "text": {
        "zh-Hant": "滿地黃花堆積，",
        "zh-Hans": "满地黄花堆积，"
      }
    },
    {
      "id": "hk-ks4-17b-l013",
      "text": {
        "zh-Hant": "憔悴損，",
        "zh-Hans": "憔悴损，"
      }
    },
    {
      "id": "hk-ks4-17b-l014",
      "text": {
        "zh-Hant": "如今有誰堪摘？",
        "zh-Hans": "如今有谁堪摘？"
      }
    },
    {
      "id": "hk-ks4-17b-l015",
      "text": {
        "zh-Hant": "守着窗兒，",
        "zh-Hans": "守着窗儿，"
      }
    },
    {
      "id": "hk-ks4-17b-l016",
      "text": {
        "zh-Hant": "獨自怎生得黑！",
        "zh-Hans": "独自怎生得黑！"
      }
    },
    {
      "id": "hk-ks4-17b-l017",
      "text": {
        "zh-Hant": "梧桐更兼細雨，",
        "zh-Hans": "梧桐更兼细雨，"
      }
    },
    {
      "id": "hk-ks4-17b-l018",
      "text": {
        "zh-Hant": "到黃昏、點點滴滴。",
        "zh-Hans": "到黄昏、点点滴滴。"
      }
    },
    {
      "id": "hk-ks4-17b-l019",
      "text": {
        "zh-Hant": "這次第，",
        "zh-Hans": "这次第，"
      }
    },
    {
      "id": "hk-ks4-17b-l020",
      "text": {
        "zh-Hant": "怎一箇愁字了得！",
        "zh-Hans": "怎一个愁字了得！"
      }
    }
  ],
