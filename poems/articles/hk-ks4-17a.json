  "lines": [
    {
      "id": "hk-ks4-17a-l001",
      "text": {
        "zh-Hant": "大江東去，",
        "zh-Hans": "大江东去，"
      }
    },
    {
      "id": "hk-ks4-17a-l002",
      "text": {
        "zh-Hant": "浪淘盡、千古風流人物。",
        "zh-Hans": "浪淘尽、千古风流人物。"
      }
    },
    {
      "id": "hk-ks4-17a-l003",
      "text": {
        "zh-Hant": "故壘西邊，",
        "zh-Hans": "故垒西边，"
      }
    },
    {
      "id": "hk-ks4-17a-l004",
      "text": {
        "zh-Hant": "人道是、三國周郎赤壁。",
        "zh-Hans": "人道是、三国周郎赤壁。"
      }
    },
    {
      "id": "hk-ks4-17a-l005",
      "text": {
        "zh-Hant": "亂石穿空，",
        "zh-Hans": "乱石穿空，"
      }
    },
    {
      "id": "hk-ks4-17a-l006",
      "text": {
        "zh-Hant": "驚濤拍岸，",
        "zh-Hans": "惊涛拍岸，"
      }
    },
    {
      "id": "hk-ks4-17a-l007",
      "text": {
        "zh-Hant": "捲起千堆雪。",
        "zh-Hans": "卷起千堆雪。"
      }
    },
    {
      "id": "hk-ks4-17a-l008",
      "text": {
        "zh-Hant": "江山如畫，",
        "zh-Hans": "江山如画，"
      }
    },
    {
      "id": "hk-ks4-17a-l009",
      "text": {
        "zh-Hant": "一時多少豪傑！",
        "zh-Hans": "一时多少豪杰！"
      }
    },
    {
      "id": "hk-ks4-17a-l010",
      "text": {
        "zh-Hant": "遙想公瑾當年，",
        "zh-Hans": "遥想公瑾当年，"
      }
    },
    {
      "id": "hk-ks4-17a-l011",
      "text": {
        "zh-Hant": "小喬初嫁了，",
        "zh-Hans": "小乔初嫁了，"
      }
    },
    {
      "id": "hk-ks4-17a-l012",
      "text": {
        "zh-Hant": "雄姿英發。",
        "zh-Hans": "雄姿英发。"
      }
    },
    {
      "id": "hk-ks4-17a-l013",
      "text": {
        "zh-Hant": "羽扇綸巾，",
        "zh-Hans": "羽扇纶巾，"
      }
    },
    {
      "id": "hk-ks4-17a-l014",
      "text": {
        "zh-Hant": "談笑間、檣櫓灰飛煙滅。",
        "zh-Hans": "谈笑间、樯橹灰飞烟灭。"
      }
    },
    {
      "id": "hk-ks4-17a-l015",
      "text": {
        "zh-Hant": "故國神遊，",
        "zh-Hans": "故国神游，"
      }
    },
    {
      "id": "hk-ks4-17a-l016",
      "text": {
        "zh-Hant": "多情應笑我，",
        "zh-Hans": "多情应笑我，"
      }
    },
    {
      "id": "hk-ks4-17a-l017",
      "text": {
        "zh-Hant": "早生華髮。",
        "zh-Hans": "早生华发。"
      }
    },
    {
      "id": "hk-ks4-17a-l018",
      "text": {
        "zh-Hant": "人間如夢，",
        "zh-Hans": "人间如梦，"
      }
    },
    {
      "id": "hk-ks4-17a-l019",
      "text": {
        "zh-Hant": "一尊還酹江月。",
        "zh-Hans": "一尊还酹江月。"
      }
    }
  ],
