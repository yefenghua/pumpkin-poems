  "lines": [
    {
      "id": "hk-ks3-18-l001",
      "text": {
        "zh-Hant": "怒髮衝冠，",
        "zh-Hans": "怒发冲冠，"
      }
    },
    {
      "id": "hk-ks3-18-l002",
      "text": {
        "zh-Hant": "憑闌處、瀟瀟雨歇。",
        "zh-Hans": "凭阑处、潇潇雨歇。"
      }
    },
    {
      "id": "hk-ks3-18-l003",
      "text": {
        "zh-Hant": "抬望眼、仰天長嘯，",
        "zh-Hans": "擡望眼、仰天长啸，"
      }
    },
    {
      "id": "hk-ks3-18-l004",
      "text": {
        "zh-Hant": "壯懷激烈。",
        "zh-Hans": "壮怀激烈。"
      }
    },
    {
      "id": "hk-ks3-18-l005",
      "text": {
        "zh-Hant": "三十功名塵與土，",
        "zh-Hans": "三十功名尘与土，"
      }
    },
    {
      "id": "hk-ks3-18-l006",
      "text": {
        "zh-Hant": "八千里路雲和月。",
        "zh-Hans": "八千里路云和月。"
      }
    },
    {
      "id": "hk-ks3-18-l007",
      "text": {
        "zh-Hant": "莫等閒、白了少年頭，",
        "zh-Hans": "莫等闲、白了少年头，"
      }
    },
    {
      "id": "hk-ks3-18-l008",
      "text": {
        "zh-Hant": "空悲切。",
        "zh-Hans": "空悲切。"
      }
    },
    {
      "id": "hk-ks3-18-l009",
      "text": {
        "zh-Hant": "靖康恥，",
        "zh-Hans": "靖康耻，"
      }
    },
    {
      "id": "hk-ks3-18-l010",
      "text": {
        "zh-Hant": "猶未雪；",
        "zh-Hans": "犹未雪；"
      }
    },
    {
      "id": "hk-ks3-18-l011",
      "text": {
        "zh-Hant": "臣子恨，",
        "zh-Hans": "臣子恨，"
      }
    },
    {
      "id": "hk-ks3-18-l012",
      "text": {
        "zh-Hant": "何時滅！",
        "zh-Hans": "何时灭！"
      }
    },
    {
      "id": "hk-ks3-18-l013",
      "text": {
        "zh-Hant": "駕長車、踏破賀蘭山缺。",
        "zh-Hans": "驾长车、踏破贺兰山缺。"
      }
    },
    {
      "id": "hk-ks3-18-l014",
      "text": {
        "zh-Hant": "壯志飢餐胡虜肉，",
        "zh-Hans": "壮志饥餐胡虏肉，"
      }
    },
    {
      "id": "hk-ks3-18-l015",
      "text": {
        "zh-Hant": "笑談渴飲匈奴血。",
        "zh-Hans": "笑谈渴饮匈奴血。"
      }
    },
    {
      "id": "hk-ks3-18-l016",
      "text": {
        "zh-Hant": "待從頭、收拾舊山河，",
        "zh-Hans": "待从头、收拾旧山河，"
      }
    },
    {
      "id": "hk-ks3-18-l017",
      "text": {
        "zh-Hant": "朝天闕。",
        "zh-Hans": "朝天阙。"
      }
    }
  ],
