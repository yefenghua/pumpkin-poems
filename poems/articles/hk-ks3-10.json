  "lines": [
    {
      "id": "hk-ks3-10-l001",
      "text": {
        "zh-Hant": "車轔轔，",
        "zh-Hans": "车辚辚，"
      }
    },
    {
      "id": "hk-ks3-10-l002",
      "text": {
        "zh-Hant": "馬蕭蕭，",
        "zh-Hans": "马萧萧，"
      }
    },
    {
      "id": "hk-ks3-10-l003",
      "text": {
        "zh-Hant": "行人弓箭各在腰，",
        "zh-Hans": "行人弓箭各在腰，"
      }
    },
    {
      "id": "hk-ks3-10-l004",
      "text": {
        "zh-Hant": "爺娘妻子走相送，",
        "zh-Hans": "爷娘妻子走相送，"
      }
    },
    {
      "id": "hk-ks3-10-l005",
      "text": {
        "zh-Hant": "塵埃不見咸陽橋。",
        "zh-Hans": "尘埃不见咸阳桥。"
      }
    },
    {
      "id": "hk-ks3-10-l006",
      "text": {
        "zh-Hant": "牽衣頓足攔道哭，",
        "zh-Hans": "牵衣顿足拦道哭，"
      }
    },
    {
      "id": "hk-ks3-10-l007",
      "text": {
        "zh-Hant": "哭聲直上干雲霄。",
        "zh-Hans": "哭声直上干云霄。"
      }
    },
    {
      "id": "hk-ks3-10-l008",
      "text": {
        "zh-Hant": "道旁過者問行人，",
        "zh-Hans": "道旁过者问行人，"
      }
    },
    {
      "id": "hk-ks3-10-l009",
      "text": {
        "zh-Hant": "行人但云點行頻。",
        "zh-Hans": "行人但云点行频。"
      }
    },
    {
      "id": "hk-ks3-10-l010",
      "text": {
        "zh-Hant": "或從十五北防河，",
        "zh-Hans": "或从十五北防河，"
      }
    },
    {
      "id": "hk-ks3-10-l011",
      "text": {
        "zh-Hant": "便至四十西營田。",
        "zh-Hans": "便至四十西营田。"
      }
    },
    {
      "id": "hk-ks3-10-l012",
      "text": {
        "zh-Hant": "去時里正與裹頭，",
        "zh-Hans": "去时里正与裹头，"
      }
    },
    {
      "id": "hk-ks3-10-l013",
      "text": {
        "zh-Hant": "歸來頭白還戍邊。",
        "zh-Hans": "归来头白还戍边。"
      }
    },
    {
      "id": "hk-ks3-10-l014",
      "text": {
        "zh-Hant": "邊庭流血成海水，",
        "zh-Hans": "边庭流血成海水，"
      }
    },
    {
      "id": "hk-ks3-10-l015",
      "text": {
        "zh-Hant": "武皇開邊意未已。",
        "zh-Hans": "武皇开边意未已。"
      }
    },
    {
      "id": "hk-ks3-10-l016",
      "text": {
        "zh-Hant": "君不聞漢家山東二百州，",
        "zh-Hans": "君不闻汉家山东二百州，"
      }
    },
    {
      "id": "hk-ks3-10-l017",
      "text": {
        "zh-Hant": "千村萬落生荊杞。",
        "zh-Hans": "千村万落生荆杞。"
      }
    },
    {
      "id": "hk-ks3-10-l018",
      "text": {
        "zh-Hant": "縱有健婦把鋤犁，",
        "zh-Hans": "纵有健妇把锄犁，"
      }
    },
    {
      "id": "hk-ks3-10-l019",
      "text": {
        "zh-Hant": "禾生隴畝無東西。",
        "zh-Hans": "禾生陇亩无东西。"
      }
    },
    {
      "id": "hk-ks3-10-l020",
      "text": {
        "zh-Hant": "況復秦兵耐苦戰，",
        "zh-Hans": "况复秦兵耐苦战，"
      }
    },
    {
      "id": "hk-ks3-10-l021",
      "text": {
        "zh-Hant": "被驅不異犬與雞。",
        "zh-Hans": "被驱不异犬与鸡。"
      }
    },
    {
      "id": "hk-ks3-10-l022",
      "text": {
        "zh-Hant": "長者雖有問，",
        "zh-Hans": "长者虽有问，"
      }
    },
    {
      "id": "hk-ks3-10-l023",
      "text": {
        "zh-Hant": "役夫敢伸恨？",
        "zh-Hans": "役夫敢伸恨？"
      }
    },
    {
      "id": "hk-ks3-10-l024",
      "text": {
        "zh-Hant": "且如今年冬，",
        "zh-Hans": "且如今年冬，"
      }
    },
    {
      "id": "hk-ks3-10-l025",
      "text": {
        "zh-Hant": "未休關西卒。",
        "zh-Hans": "未休关西卒。"
      }
    },
    {
      "id": "hk-ks3-10-l026",
      "text": {
        "zh-Hant": "縣官急索租，",
        "zh-Hans": "县官急索租，"
      }
    },
    {
      "id": "hk-ks3-10-l027",
      "text": {
        "zh-Hant": "租稅從何出？",
        "zh-Hans": "租税从何出？"
      }
    },
    {
      "id": "hk-ks3-10-l028",
      "text": {
        "zh-Hant": "信知生男惡，",
        "zh-Hans": "信知生男恶，"
      }
    },
    {
      "id": "hk-ks3-10-l029",
      "text": {
        "zh-Hant": "反是生女好；",
        "zh-Hans": "反是生女好；"
      }
    },
    {
      "id": "hk-ks3-10-l030",
      "text": {
        "zh-Hant": "生女猶得嫁比鄰，",
        "zh-Hans": "生女犹得嫁比邻，"
      }
    },
    {
      "id": "hk-ks3-10-l031",
      "text": {
        "zh-Hant": "生男埋沒隨百草。",
        "zh-Hans": "生男埋没随百草。"
      }
    },
    {
      "id": "hk-ks3-10-l032",
      "text": {
        "zh-Hant": "君不見青海頭，",
        "zh-Hans": "君不见青海头，"
      }
    },
    {
      "id": "hk-ks3-10-l033",
      "text": {
        "zh-Hant": "古來白骨無人收，",
        "zh-Hans": "古来白骨无人收，"
      }
    },
    {
      "id": "hk-ks3-10-l034",
      "text": {
        "zh-Hant": "新鬼煩冤舊鬼哭，",
        "zh-Hans": "新鬼烦冤旧鬼哭，"
      }
    },
    {
      "id": "hk-ks3-10-l035",
      "text": {
        "zh-Hant": "天陰雨濕聲啾啾！",
        "zh-Hans": "天阴雨湿声啾啾！"
      }
    }
  ],
