      "text": {
        "zh-Hant": "漁翁夜傍西巖宿，",
        "zh-Hans": "渔翁夜傍西岩宿，"
      }
    },
    {
      "id": "ext-tang-204-l002",
      "text": {
        "zh-Hant": "曉汲清湘燃楚竹。",
        "zh-Hans": "晓汲清湘燃楚竹。"
      }
    },
    {
      "id": "ext-tang-204-l003",
      "text": {
        "zh-Hant": "煙銷日出不見人，",
        "zh-Hans": "烟销日出不见人，"
      }
    },
    {
      "id": "ext-tang-204-l004",
      "text": {
        "zh-Hant": "欸乃一聲山水綠。",
        "zh-Hans": "欸乃一声山水绿。"
      }
    },
    {
      "id": "ext-tang-204-l005",
      "text": {
        "zh-Hant": "迴看天際下中流，",
        "zh-Hans": "回看天际下中流，"
      }
    },
    {
      "id": "ext-tang-204-l006",
      "text": {
        "zh-Hant": "巖上無心雲相逐。",
        "zh-Hans": "岩上无心云相逐。"
      }
    }
  ],
