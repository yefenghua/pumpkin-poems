  "curriculum": null,
  "text": {
    "zh-Hant": "移舟泊煙渚，日暮客愁新。野曠天低樹，江清月近人。",
    "zh-Hans": "移舟泊烟渚，日暮客愁新。野旷天低树，江清月近人。"
  },
