  "text": {
    "zh-Hant": "明月幾時有？把酒問青天。不知天上宮闕，今夕是何年。我欲乘風歸去，又恐瓊樓玉宇，高處不勝寒。起舞弄清影，何似在人間！轉朱閣，低綺戶，照無眠。不應有恨，何事長向別時圓？人有悲歡離合，月有陰晴圓缺，此事古難全。但願人長久，千里共嬋娟。",
    "zh-Hans": "明月几时有？把酒问青天。不知天上宫阙，今夕是何年。我欲乘风归去，又恐琼楼玉宇，高处不胜寒。起舞弄清影，何似在人间！转朱阁，低绮户，照无眠。不应有恨，何事长向别时圆？人有悲欢离合，月有阴晴圆缺，此事古难全。但愿人长久，千里共婵娟。"
  },
  "preface": {
    "zh-Hant": "丙辰中秋，歡飲達旦，大醉，作此篇，兼懷子由。",
    "zh-Hans": "丙辰中秋，欢饮达旦，大醉，作此篇，兼怀子由。"
  },
  "lines": [
    {
      "id": "hk-ks3-17-l001",
      "text": {
        "zh-Hant": "明月幾時有？",
        "zh-Hans": "明月几时有？"
      }
    },
    {
      "id": "hk-ks3-17-l002",
      "text": {
        "zh-Hant": "把酒問青天。",
        "zh-Hans": "把酒问青天。"
      }
    },
    {
      "id": "hk-ks3-17-l003",
      "text": {
        "zh-Hant": "不知天上宮闕，",
        "zh-Hans": "不知天上宫阙，"
      }
    },
    {
      "id": "hk-ks3-17-l004",
      "text": {
        "zh-Hant": "今夕是何年。",
        "zh-Hans": "今夕是何年。"
      }
    },
    {
      "id": "hk-ks3-17-l005",
      "text": {
        "zh-Hant": "我欲乘風歸去，",
        "zh-Hans": "我欲乘风归去，"
      }
    },
    {
      "id": "hk-ks3-17-l006",
      "text": {
        "zh-Hant": "又恐瓊樓玉宇，",
        "zh-Hans": "又恐琼楼玉宇，"
      }
    },
    {
      "id": "hk-ks3-17-l007",
      "text": {
        "zh-Hant": "高處不勝寒。",
        "zh-Hans": "高处不胜寒。"
      }
    },
    {
      "id": "hk-ks3-17-l008",
      "text": {
        "zh-Hant": "起舞弄清影，",
        "zh-Hans": "起舞弄清影，"
      }
    },
    {
      "id": "hk-ks3-17-l009",
      "text": {
        "zh-Hant": "何似在人間！",
        "zh-Hans": "何似在人间！"
      }
    },
    {
      "id": "hk-ks3-17-l010",
      "text": {
        "zh-Hant": "轉朱閣，",
        "zh-Hans": "转朱阁，"
      }
    },
    {
      "id": "hk-ks3-17-l011",
      "text": {
        "zh-Hant": "低綺戶，",
        "zh-Hans": "低绮户，"
      }
    },
    {
      "id": "hk-ks3-17-l012",
      "text": {
        "zh-Hant": "照無眠。",
        "zh-Hans": "照无眠。"
      }
    },
    {
      "id": "hk-ks3-17-l013",
      "text": {
        "zh-Hant": "不應有恨，",
        "zh-Hans": "不应有恨，"
      }
    },
    {
      "id": "hk-ks3-17-l014",
      "text": {
        "zh-Hant": "何事長向別時圓？",
        "zh-Hans": "何事长向别时圆？"
      }
    },
    {
      "id": "hk-ks3-17-l015",
      "text": {
        "zh-Hant": "人有悲歡離合，",
        "zh-Hans": "人有悲欢离合，"
      }
    },
    {
      "id": "hk-ks3-17-l016",
      "text": {
        "zh-Hant": "月有陰晴圓缺，",
        "zh-Hans": "月有阴晴圆缺，"
      }
    },
    {
      "id": "hk-ks3-17-l017",
      "text": {
        "zh-Hant": "此事古難全。",
        "zh-Hans": "此事古难全。"
      }
    },
    {
      "id": "hk-ks3-17-l018",
      "text": {
        "zh-Hant": "但願人長久，",
        "zh-Hans": "但愿人长久，"
      }
    },
    {
      "id": "hk-ks3-17-l019",
      "text": {
        "zh-Hant": "千里共嬋娟。",
        "zh-Hans": "千里共婵娟。"
      }
    }
  ],
