    {
      "id": "ext-song-208-l012",
      "text": {
        "zh-Hant": "休説鱸魚堪膾。",
        "zh-Hans": "休说鲈鱼堪脍。"
      }
    },
    {
      "id": "ext-song-208-l013",
      "text": {
        "zh-Hant": "盡西風、季鷹歸未。",
        "zh-Hans": "尽西风、季鹰归未。"
      }
    },
    {
      "id": "ext-song-208-l014",
      "text": {
        "zh-Hant": "求田問舍，",
        "zh-Hans": "求田问舍，"
      }
    },
    {
      "id": "ext-song-208-l015",
      "text": {
        "zh-Hant": "怕應羞見，",
        "zh-Hans": "怕应羞见，"
      }
    },
    {
      "id": "ext-song-208-l016",
      "text": {
        "zh-Hant": "劉郎才氣。",
        "zh-Hans": "刘郎才气。"
      }
    },
    {
      "id": "ext-song-208-l017",
      "text": {
        "zh-Hant": "可惜流年，",
        "zh-Hans": "可惜流年，"
      }
    },
    {
      "id": "ext-song-208-l018",
      "text": {
        "zh-Hant": "憂愁風雨，",
        "zh-Hans": "忧愁风雨，"
      }
    },
    {
      "id": "ext-song-208-l019",
      "text": {
        "zh-Hant": "樹猶如此。",
        "zh-Hans": "树犹如此。"
      }
    },
    {
      "id": "ext-song-208-l020",
      "text": {
        "zh-Hant": "倩何人，",
        "zh-Hans": "倩何人，"
      }
    },
    {
      "id": "ext-song-208-l021",
      "text": {
        "zh-Hant": "喚取紅巾翠袖，",
        "zh-Hans": "唤取红巾翠袖，"
      }
    },
    {
      "id": "ext-song-208-l022",
      "text": {
        "zh-Hant": "揾英雄淚。",
        "zh-Hans": "揾英雄泪。"
      }
    }
