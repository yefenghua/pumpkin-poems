      "text": {
        "zh-Hant": "行到水窮處，",
        "zh-Hans": "行到水穷处，"
      }
    },
    {
      "id": "ext-tang-134-l006",
      "text": {
        "zh-Hant": "坐看雲起時。",
        "zh-Hans": "坐看云起时。"
      }
    },
    {
      "id": "ext-tang-134-l007",
      "text": {
        "zh-Hant": "偶然值林叟，",
        "zh-Hans": "偶然值林叟，"
