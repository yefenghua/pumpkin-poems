        "zh-Hans": "相去万余里，"
      }
    },
    {
      "id": "hk-ks3-05a-l004",
      "text": {
        "zh-Hant": "各在天一涯。",
        "zh-Hans": "各在天一涯。"
      }
    },
    {
      "id": "hk-ks3-05a-l005",
      "text": {
        "zh-Hant": "道路阻且長，",
        "zh-Hans": "道路阻且长，"
      }
    },
    {
      "id": "hk-ks3-05a-l006",
      "text": {
        "zh-Hant": "會面安可知？",
        "zh-Hans": "会面安可知？"
      }
    },
    {
      "id": "hk-ks3-05a-l007",
      "text": {
        "zh-Hant": "胡馬依北風，",
        "zh-Hans": "胡马依北风，"
      }
    },
    {
      "id": "hk-ks3-05a-l008",
      "text": {
        "zh-Hant": "越鳥巢南枝！",
        "zh-Hans": "越鸟巢南枝！"
      }
    },
    {
      "id": "hk-ks3-05a-l009",
      "text": {
        "zh-Hant": "相去日已遠，",
        "zh-Hans": "相去日已远，"
      }
    },
    {
      "id": "hk-ks3-05a-l010",
      "text": {
        "zh-Hant": "衣帶日已緩。",
        "zh-Hans": "衣带日已缓。"
      }
    },
    {
      "id": "hk-ks3-05a-l011",
      "text": {
        "zh-Hant": "浮雲蔽白日，",
        "zh-Hans": "浮云蔽白日，"
      }
    },
    {
      "id": "hk-ks3-05a-l012",
      "text": {
        "zh-Hant": "遊子不顧返。",
        "zh-Hans": "游子不顾返。"
      }
    },
    {
      "id": "hk-ks3-05a-l013",
      "text": {
        "zh-Hant": "思君令人老，",
        "zh-Hans": "思君令人老，"
      }
    },
    {
      "id": "hk-ks3-05a-l014",
      "text": {
        "zh-Hant": "歲月忽已晚。",
        "zh-Hans": "岁月忽已晚。"
      }
    },
    {
      "id": "hk-ks3-05a-l015",
      "text": {
        "zh-Hant": "棄捐勿復道，",
        "zh-Hans": "弃捐勿复道，"
      }
    },
    {
      "id": "hk-ks3-05a-l016",
      "text": {
        "zh-Hant": "努力加餐飯！",
        "zh-Hans": "努力加餐饭！"
      }
    }
  ],
