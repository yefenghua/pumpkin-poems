  "curriculum": null,
  "text": {
    "zh-Hant": "紅豆生南國，秋來發故枝。願君多采擷，此物最相思。",
    "zh-Hans": "红豆生南国，秋来发故枝。愿君多采撷，此物最相思。"
  },
