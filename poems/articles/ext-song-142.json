    },
    {
      "id": "ext-song-142-l003",
      "text": {
        "zh-Hant": "驟雨初歇。",
        "zh-Hans": "骤雨初歇。"
      }
    },
    {
      "id": "ext-song-142-l004",
      "text": {
        "zh-Hant": "都門帳飲無緒，",
        "zh-Hans": "都门帐饮无绪，"
      }
    },
    {
      "id": "ext-song-142-l005",
      "text": {
        "zh-Hant": "留戀處、蘭舟催發。",
        "zh-Hans": "留恋处、兰舟催发。"
      }
    },
    {
      "id": "ext-song-142-l006",
      "text": {
        "zh-Hant": "執手相看淚眼，",
        "zh-Hans": "执手相看泪眼，"
      }
    },
    {
      "id": "ext-song-142-l007",
      "text": {
        "zh-Hant": "竟無語凝噎。",
        "zh-Hans": "竟无语凝噎。"
      }
    },
    {
      "id": "ext-song-142-l008",
      "text": {
        "zh-Hant": "念去去、千里煙波，",
        "zh-Hans": "念去去、千里烟波，"
      }
    },
    {
      "id": "ext-song-142-l009",
      "text": {
        "zh-Hant": "暮靄沉沉楚天闊。",
        "zh-Hans": "暮霭沉沉楚天阔。"
      }
    },
    {
      "id": "ext-song-142-l010",
      "text": {
        "zh-Hant": "多情自古傷離別。",
        "zh-Hans": "多情自古伤离别。"
      }
    },
    {
      "id": "ext-song-142-l011",
      "text": {
        "zh-Hant": "更那堪、冷落清秋節。",
        "zh-Hans": "更那堪、冷落清秋节。"
      }
    },
    {
      "id": "ext-song-142-l012",
      "text": {
        "zh-Hant": "今宵酒醒何處，",
        "zh-Hans": "今宵酒醒何处，"
      }
    },
    {
      "id": "ext-song-142-l013",
      "text": {
        "zh-Hant": "楊柳岸、曉風殘月。",
        "zh-Hans": "杨柳岸、晓风残月。"
      }
    },
    {
      "id": "ext-song-142-l014",
      "text": {
        "zh-Hant": "此去經年，",
        "zh-Hans": "此去经年，"
      }
    },
    {
      "id": "ext-song-142-l015",
      "text": {
        "zh-Hant": "應是良辰、好景虛設。",
        "zh-Hans": "应是良辰、好景虚设。"
      }
    },
    {
      "id": "ext-song-142-l016",
      "text": {
        "zh-Hant": "便縱有、千種風情，",
        "zh-Hans": "便纵有、千种风情，"
      }
    },
    {
      "id": "ext-song-142-l017",
      "text": {
        "zh-Hant": "更與何人説。",
        "zh-Hans": "更与何人说。"
      }
    }
