  "lines": [
    {
      "id": "ext-tang-325-l001",
      "text": {
        "zh-Hant": "鳳凰臺上鳳凰遊，",
        "zh-Hans": "凤凰台上凤凰游，"
      }
    },
    {
      "id": "ext-tang-325-l002",
      "text": {
        "zh-Hant": "鳳去臺空江自流。",
        "zh-Hans": "凤去台空江自流。"
      }
    },
    {
      "id": "ext-tang-325-l003",
      "text": {
        "zh-Hant": "吳宮花草埋幽徑，",
        "zh-Hans": "吴宫花草埋幽径，"
      }
    },
    {
      "id": "ext-tang-325-l004",
      "text": {
        "zh-Hant": "晉代衣冠成古丘。",
        "zh-Hans": "晋代衣冠成古丘。"
      }
    },
    {
      "id": "ext-tang-325-l005",
      "text": {
        "zh-Hant": "三山半落青天外，",
        "zh-Hans": "三山半落青天外，"
      }
    },
    {
      "id": "ext-tang-325-l006",
      "text": {
        "zh-Hant": "二水中分白鷺洲。",
        "zh-Hans": "二水中分白鹭洲。"
      }
    },
    {
      "id": "ext-tang-325-l007",
      "text": {
        "zh-Hant": "總爲浮雲能蔽日，",
        "zh-Hans": "总为浮云能蔽日，"
      }
    },
    {
      "id": "ext-tang-325-l008",
      "text": {
        "zh-Hant": "長安不見使人愁。",
        "zh-Hans": "长安不见使人愁。"
      }
    }
  ],
