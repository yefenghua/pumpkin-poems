  "lines": [
    {
      "id": "hk-ks3-11b-l001",
      "text": {
        "zh-Hant": "慈烏失其母，",
        "zh-Hans": "慈乌失其母，"
      }
    },
    {
      "id": "hk-ks3-11b-l002",
      "text": {
        "zh-Hant": "啞啞吐哀音。",
        "zh-Hans": "哑哑吐哀音。"
      }
    },
    {
      "id": "hk-ks3-11b-l003",
      "text": {
        "zh-Hant": "晝夜不飛去，",
        "zh-Hans": "昼夜不飞去，"
      }
    },
    {
      "id": "hk-ks3-11b-l004",
      "text": {
        "zh-Hant": "經年守故林。",
        "zh-Hans": "经年守故林。"
      }
    },
    {
      "id": "hk-ks3-11b-l005",
      "text": {
        "zh-Hant": "夜夜夜半啼，",
        "zh-Hans": "夜夜夜半啼，"
      }
    },
    {
      "id": "hk-ks3-11b-l006",
      "text": {
        "zh-Hant": "聞者為霑襟。",
        "zh-Hans": "闻者为沾襟。"
      }
    },
    {
      "id": "hk-ks3-11b-l007",
      "text": {
        "zh-Hant": "聲中如告訴，",
        "zh-Hans": "声中如告诉，"
      }
    },
    {
      "id": "hk-ks3-11b-l008",
      "text": {
        "zh-Hant": "未盡反哺心。",
        "zh-Hans": "未尽反哺心。"
      }
    },
    {
      "id": "hk-ks3-11b-l009",
      "text": {
        "zh-Hant": "百鳥豈無母？",
        "zh-Hans": "百鸟岂无母？"
      }
    },
    {
      "id": "hk-ks3-11b-l010",
      "text": {
        "zh-Hant": "爾獨哀怨深。",
        "zh-Hans": "尔独哀怨深。"
      }
    },
    {
      "id": "hk-ks3-11b-l011",
      "text": {
        "zh-Hant": "應是母慈重，",
        "zh-Hans": "应是母慈重，"
      }
    },
    {
      "id": "hk-ks3-11b-l012",
      "text": {
        "zh-Hant": "使爾悲不任。",
        "zh-Hans": "使尔悲不任。"
      }
    },
    {
      "id": "hk-ks3-11b-l013",
      "text": {
        "zh-Hant": "昔有吳起者，",
        "zh-Hans": "昔有吴起者，"
      }
    },
    {
      "id": "hk-ks3-11b-l014",
      "text": {
        "zh-Hant": "母歿喪不臨。",
        "zh-Hans": "母殁丧不临。"
      }
    },
    {
      "id": "hk-ks3-11b-l015",
      "text": {
        "zh-Hant": "嗟哉斯徒輩，",
        "zh-Hans": "嗟哉斯徒辈，"
      }
    },
    {
      "id": "hk-ks3-11b-l016",
      "text": {
        "zh-Hant": "其心不如禽！",
        "zh-Hans": "其心不如禽！"
      }
    },
    {
      "id": "hk-ks3-11b-l017",
      "text": {
        "zh-Hant": "慈烏復慈烏，",
        "zh-Hans": "慈乌复慈乌，"
      }
    },
    {
      "id": "hk-ks3-11b-l018",
      "text": {
        "zh-Hant": "鳥中之曾參。",
        "zh-Hans": "鸟中之曾参。"
      }
    }
  ],
