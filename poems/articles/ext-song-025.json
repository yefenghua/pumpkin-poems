      "text": {
        "zh-Hant": "留人不住。",
        "zh-Hans": "留人不住。"
      }
    },
    {
      "id": "ext-song-025-l002",
      "text": {
        "zh-Hant": "醉解蘭舟去。",
        "zh-Hans": "醉解兰舟去。"
      }
    },
    {
      "id": "ext-song-025-l003",
      "text": {
        "zh-Hant": "一棹碧濤春水路。",
        "zh-Hans": "一棹碧涛春水路。"
      }
    },
    {
      "id": "ext-song-025-l004",
      "text": {
        "zh-Hant": "過盡曉鶯啼處。",
        "zh-Hans": "过尽晓莺啼处。"
      }
    },
    {
      "id": "ext-song-025-l005",
      "text": {
        "zh-Hant": "渡頭楊柳青青。",
        "zh-Hans": "渡头杨柳青青。"
      }
    },
    {
      "id": "ext-song-025-l006",
      "text": {
        "zh-Hant": "枝枝葉葉離情。",
        "zh-Hans": "枝枝叶叶离情。"
      }
    },
    {
      "id": "ext-song-025-l007",
      "text": {
        "zh-Hant": "此後錦書休寄，",
        "zh-Hans": "此后锦书休寄，"
      }
    },
    {
      "id": "ext-song-025-l008",
      "text": {
        "zh-Hant": "畫樓雲雨無憑。",
        "zh-Hans": "画楼云雨无凭。"
      }
    }
