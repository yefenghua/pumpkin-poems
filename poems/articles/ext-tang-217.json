  "lines": [
    {
      "id": "ext-tang-217-l001",
      "text": {
        "zh-Hant": "風急天高猿嘯哀，",
        "zh-Hans": "风急天高猿啸哀，"
      }
    },
    {
      "id": "ext-tang-217-l002",
      "text": {
        "zh-Hant": "渚清沙白鳥飛迴。",
        "zh-Hans": "渚清沙白鸟飞回。"
      }
    },
    {
      "id": "ext-tang-217-l003",
      "text": {
        "zh-Hant": "無邊落木蕭蕭下，",
        "zh-Hans": "无边落木萧萧下，"
      }
    },
    {
      "id": "ext-tang-217-l004",
      "text": {
        "zh-Hant": "不盡長江滾滾來。",
        "zh-Hans": "不尽长江滚滚来。"
      }
    },
    {
      "id": "ext-tang-217-l005",
      "text": {
        "zh-Hant": "萬里悲秋常作客，",
        "zh-Hans": "万里悲秋常作客，"
      }
    },
    {
      "id": "ext-tang-217-l006",
      "text": {
        "zh-Hant": "百年多病獨登臺。",
        "zh-Hans": "百年多病独登台。"
      }
    },
    {
      "id": "ext-tang-217-l007",
      "text": {
        "zh-Hant": "艱難苦恨繁霜鬢，",
        "zh-Hans": "艰难苦恨繁霜鬓，"
      }
    },
    {
      "id": "ext-tang-217-l008",
      "text": {
        "zh-Hant": "潦倒新停濁酒杯。",
        "zh-Hans": "潦倒新停浊酒杯。"
      }
    }
  ],
