      }
    },
    {
      "id": "ext-song-019-l002",
      "text": {
        "zh-Hant": "酒醒簾幕低垂。",
        "zh-Hans": "酒醒帘幕低垂。"
      }
    },
    {
      "id": "ext-song-019-l003",
      "text": {
        "zh-Hant": "去年春恨卻來時。",
        "zh-Hans": "去年春恨却来时。"
      }
    },
    {
      "id": "ext-song-019-l004",
      "text": {
        "zh-Hant": "落花人獨立，",
        "zh-Hans": "落花人独立，"
      }
    },
    {
