        "zh-Hans": "微雨燕双飞。"
      }
    },
    {
      "id": "ext-song-019-l006",
      "text": {
        "zh-Hant": "記得小蘋初見，",
        "zh-Hans": "记得小苹初见，"
      }
    },
    {
      "id": "ext-song-019-l007",
      "text": {
        "zh-Hant": "兩重心字羅衣。",
        "zh-Hans": "两重心字罗衣。"
      }
    },
    {
      "id": "ext-song-019-l008",
      "text": {
        "zh-Hant": "琵琶弦上説相思。",
        "zh-Hans": "琵琶弦上说相思。"
      }
    },
    {
      "id": "ext-song-019-l009",
      "text": {
        "zh-Hant": "當時明月在，",
        "zh-Hans": "当时明月在，"
      }
    },
    {
      "id": "ext-song-019-l010",
      "text": {
        "zh-Hant": "曾照彩雲歸。",
        "zh-Hans": "曾照彩云归。"
      }
    }
