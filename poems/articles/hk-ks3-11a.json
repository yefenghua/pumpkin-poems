  "text": {
    "zh-Hant": "梁上有雙燕，翩翩雄與雌。銜泥兩椽間，一巢生四兒。四兒日夜長，索食聲孜孜。青蟲不易捕，黃口無飽期。嘴爪雖欲敝，心力不知疲。須臾十來往，猶恐巢中飢。辛勤三十日，母瘦雛漸肥。喃喃教言語，一一刷毛衣。一旦羽翼成，引上庭樹枝。舉翅不回顧，隨風四散飛。雌雄空中鳴，聲盡呼不歸。卻入空巢裏，啁啾終夜悲。燕燕爾勿悲，爾當反自思：思爾為雛日，高飛背母時。當時父母念，今日爾應知！",
    "zh-Hans": "梁上有双燕，翩翩雄与雌。衔泥两椽间，一巢生四儿。四儿日夜长，索食声孜孜。青虫不易捕，黄口无饱期。嘴爪虽欲敝，心力不知疲。须臾十来往，犹恐巢中饥。辛勤三十日，母瘦雏渐肥。喃喃教言语，一一刷毛衣。一旦羽翼成，引上庭树枝。举翅不回顾，随风四散飞。雌雄空中鸣，声尽呼不归。却入空巢里，啁啾终夜悲。燕燕尔勿悲，尔当反自思：思尔为雏日，高飞背母时。当时父母念，今日尔应知！"
  },
  "preface": {
    "zh-Hant": "叟有愛子，背叟逃去，叟甚悲念之。叟少年時，亦嘗如是。故作《燕詩》以諭之矣。",
    "zh-Hans": "叟有爱子，背叟逃去，叟甚悲念之。叟少年时，亦尝如是。故作《燕诗》以谕之矣。"
  },
  "lines": [
    {
      "id": "hk-ks3-11a-l001",
      "text": {
        "zh-Hant": "梁上有雙燕，",
        "zh-Hans": "梁上有双燕，"
      }
    },
    {
      "id": "hk-ks3-11a-l002",
      "text": {
        "zh-Hant": "翩翩雄與雌。",
        "zh-Hans": "翩翩雄与雌。"
      }
    },
    {
      "id": "hk-ks3-11a-l003",
      "text": {
        "zh-Hant": "銜泥兩椽間，",
        "zh-Hans": "衔泥两椽间，"
      }
    },
    {
      "id": "hk-ks3-11a-l004",
      "text": {
        "zh-Hant": "一巢生四兒。",
        "zh-Hans": "一巢生四儿。"
      }
    },
    {
      "id": "hk-ks3-11a-l005",
      "text": {
        "zh-Hant": "四兒日夜長，",
        "zh-Hans": "四儿日夜长，"
      }
    },
    {
      "id": "hk-ks3-11a-l006",
      "text": {
        "zh-Hant": "索食聲孜孜。",
        "zh-Hans": "索食声孜孜。"
      }
    },
    {
      "id": "hk-ks3-11a-l007",
      "text": {
        "zh-Hant": "青蟲不易捕，",
        "zh-Hans": "青虫不易捕，"
      }
    },
    {
      "id": "hk-ks3-11a-l008",
      "text": {
        "zh-Hant": "黃口無飽期。",
        "zh-Hans": "黄口无饱期。"
      }
    },
    {
      "id": "hk-ks3-11a-l009",
      "text": {
        "zh-Hant": "嘴爪雖欲敝，",
        "zh-Hans": "嘴爪虽欲敝，"
      }
    },
    {
      "id": "hk-ks3-11a-l010",
      "text": {
        "zh-Hant": "心力不知疲。",
        "zh-Hans": "心力不知疲。"
      }
    },
    {
      "id": "hk-ks3-11a-l011",
      "text": {
        "zh-Hant": "須臾十來往，",
        "zh-Hans": "须臾十来往，"
      }
    },
    {
      "id": "hk-ks3-11a-l012",
      "text": {
        "zh-Hant": "猶恐巢中飢。",
        "zh-Hans": "犹恐巢中饥。"
      }
    },
    {
      "id": "hk-ks3-11a-l013",
      "text": {
        "zh-Hant": "辛勤三十日，",
        "zh-Hans": "辛勤三十日，"
      }
    },
    {
      "id": "hk-ks3-11a-l014",
      "text": {
        "zh-Hant": "母瘦雛漸肥。",
        "zh-Hans": "母瘦雏渐肥。"
      }
    },
    {
      "id": "hk-ks3-11a-l015",
      "text": {
        "zh-Hant": "喃喃教言語，",
        "zh-Hans": "喃喃教言语，"
      }
    },
    {
      "id": "hk-ks3-11a-l016",
      "text": {
        "zh-Hant": "一一刷毛衣。",
        "zh-Hans": "一一刷毛衣。"
      }
    },
    {
      "id": "hk-ks3-11a-l017",
      "text": {
        "zh-Hant": "一旦羽翼成，",
        "zh-Hans": "一旦羽翼成，"
      }
    },
    {
      "id": "hk-ks3-11a-l018",
      "text": {
        "zh-Hant": "引上庭樹枝。",
        "zh-Hans": "引上庭树枝。"
      }
    },
    {
      "id": "hk-ks3-11a-l019",
      "text": {
        "zh-Hant": "舉翅不回顧，",
        "zh-Hans": "举翅不回顾，"
      }
    },
    {
      "id": "hk-ks3-11a-l020",
      "text": {
        "zh-Hant": "隨風四散飛。",
        "zh-Hans": "随风四散飞。"
      }
    },
    {
      "id": "hk-ks3-11a-l021",
      "text": {
        "zh-Hant": "雌雄空中鳴，",
        "zh-Hans": "雌雄空中鸣，"
      }
    },
    {
      "id": "hk-ks3-11a-l022",
      "text": {
        "zh-Hant": "聲盡呼不歸。",
        "zh-Hans": "声尽呼不归。"
      }
    },
    {
      "id": "hk-ks3-11a-l023",
      "text": {
        "zh-Hant": "卻入空巢裏，",
        "zh-Hans": "却入空巢里，"
      }
    },
    {
      "id": "hk-ks3-11a-l024",
      "text": {
        "zh-Hant": "啁啾終夜悲。",
        "zh-Hans": "啁啾终夜悲。"
      }
    },
    {
      "id": "hk-ks3-11a-l025",
      "text": {
        "zh-Hant": "燕燕爾勿悲，",
        "zh-Hans": "燕燕尔勿悲，"
      }
    },
    {
      "id": "hk-ks3-11a-l026",
      "text": {
        "zh-Hant": "爾當反自思：思爾為雛日，",
        "zh-Hans": "尔当反自思：思尔为雏日，"
      }
    },
    {
      "id": "hk-ks3-11a-l027",
      "text": {
        "zh-Hant": "高飛背母時。",
        "zh-Hans": "高飞背母时。"
      }
    },
    {
      "id": "hk-ks3-11a-l028",
      "text": {
        "zh-Hant": "當時父母念，",
        "zh-Hans": "当时父母念，"
      }
    },
    {
      "id": "hk-ks3-11a-l029",
      "text": {
        "zh-Hant": "今日爾應知！",
        "zh-Hans": "今日尔应知！"
      }
    }
  ],
