  "curriculum": null,
  "text": {
    "zh-Hant": "三日入廚下，洗手作羹湯。未諳姑食性，先遣小姑嘗。",
    "zh-Hans": "三日入厨下，洗手作羹汤。未谙姑食性，先遣小姑尝。"
  },
